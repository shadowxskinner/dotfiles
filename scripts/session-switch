#!/usr/bin/env bash
# Themed power and session menu for Midnight-PC.
# DMS 1.6 powermenu IPC is only open/close/toggle, so this menu owns Lock,
# Suspend, Log out, Shut down, Reboot Linux, Switch to KDE, and Windows 11.
set -euo pipefail

helper="/usr/local/bin/midnight-session-helper"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/theme-manager"
yes="${SESSION_SWITCH_YES:-0}"
dry_run="${SESSION_SWITCH_DRY_RUN:-0}"

die() { echo "session-switch: $*" >&2; exit 1; }

notify() {
  command -v notify-send >/dev/null && notify-send "Session" "$1" || true
}

on_hyprland() {
  case "${XDG_CURRENT_DESKTOP:-}" in
    *Hyprland*|*hyprland*) return 0 ;;
  esac
  command -v pgrep >/dev/null && pgrep -x Hyprland >/dev/null 2>&1
}

desktop_name() {
  local desktop="${XDG_CURRENT_DESKTOP:-}"
  case "$desktop" in
    *Hyprland*|*hyprland*) echo hyprland ;;
    *KDE*|*plasma*|*Plasma*) echo plasma ;;
    *) echo "${desktop:-unknown}" ;;
  esac
}

windows_boot_status() {
  local line id
  command -v efibootmgr >/dev/null || { echo unavailable; return 0; }
  line="$(efibootmgr 2>/dev/null | grep -F 'Windows Boot Manager' | head -n1 || true)"
  if [[ -z "$line" ]]; then
    echo unavailable
    return 0
  fi
  id="${line#Boot}"
  id="${id%%[[:space:]]*}"
  id="${id%\*}"
  echo "$id Windows Boot Manager"
}

helper_status() {
  if [[ -x "$helper" ]]; then
    echo installed
  else
    echo missing
  fi
}

wofi_style() {
  local theme=dragon path fallback
  if [[ -f "$state_dir/current" ]]; then
    theme="$(tr -d '[:space:]' <"$state_dir/current" || true)"
  fi
  path="$HOME/.config/wofi/themes/${theme}.css"
  if [[ -f "$path" ]]; then
    printf '%s\n' "$path"
    return 0
  fi
  fallback="$HOME/.config/wofi/style.css"
  [[ -f "$fallback" ]] && printf '%s\n' "$fallback"
}

pick() {
  local prompt="$1" lines="$2" style args
  [[ -n "$lines" ]] || return 1
  args=(wofi --dmenu --prompt "$prompt" --width 420 --location top_right --yoffset 12)
  style="$(wofi_style || true)"
  [[ -n "$style" ]] && args+=(--style "$style")
  if on_hyprland; then
    args+=(-D close_on_focus_loss=false)
  fi
  printf '%s\n' "$lines" | "${args[@]}" 2>/dev/null || true
}

confirm() {
  local question="$1" choice
  [[ "$yes" == 1 ]] && return 0
  choice="$(pick "Confirm" "$(printf 'No\nYes — %s' "$question")")"
  [[ "$choice" == Yes* ]]
}

run_user() {
  if [[ "$dry_run" == 1 ]]; then
    printf 'dry-run:'
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  "$@"
}

run_helper() {
  local target="$1"
  if [[ "$dry_run" == 1 ]]; then
    printf 'dry-run: pkexec %q --dry-run %q\n' "$helper" "$target"
    return 0
  fi
  [[ -x "$helper" ]] || die "pkexec helper is not installed; see install.sh"
  pkexec "$helper" "$target"
}

do_lock() {
  if command -v loginctl >/dev/null; then
    run_user loginctl lock-session
    return 0
  fi
  die "loginctl is not available"
}

do_suspend() {
  confirm "suspend this machine" || return 0
  run_user systemctl suspend
}

do_logout() {
  confirm "log out of this session" || return 0
  if on_hyprland && command -v hyprctl >/dev/null; then
    run_user hyprctl dispatch exit
    return 0
  fi
  run_user loginctl terminate-session "${XDG_SESSION_ID:?}"
}

do_shutdown() {
  confirm "shut down this machine" || return 0
  run_user systemctl poweroff
}

do_reboot() {
  confirm "reboot Linux" || return 0
  run_user systemctl reboot
}

do_kde() {
  confirm "switch to KDE for one login" || return 0
  notify "Switching to Plasma once for Sunshine/Moonlight"
  run_helper kde
}

do_windows() {
  confirm "reboot once into Windows 11" || return 0
  notify "Rebooting once into Windows 11"
  run_helper windows
}

show_menu() {
  local choice
  choice="$(pick "Power" $'Lock\nSuspend\nLog out\nShut down\nReboot Linux\nSwitch to KDE\nReboot once into Windows 11')"
  case "$choice" in
    "Lock") do_lock ;;
    "Suspend") do_suspend ;;
    "Log out") do_logout ;;
    "Shut down") do_shutdown ;;
    "Reboot Linux") do_reboot ;;
    "Switch to KDE") do_kde ;;
    "Reboot once into Windows 11") do_windows ;;
    "") return 0 ;;
    *) die "unrecognised choice '$choice'" ;;
  esac
}

show_status() {
  printf 'desktop: %s\n' "$(desktop_name)"
  printf 'windows-boot: %s\n' "$(windows_boot_status)"
  printf 'helper: %s\n' "$(helper_status)"
}

case "${1:-menu}" in
  menu) show_menu ;;
  lock) do_lock ;;
  suspend) do_suspend ;;
  logout) do_logout ;;
  shutdown) do_shutdown ;;
  reboot) do_reboot ;;
  kde) do_kde ;;
  windows) do_windows ;;
  status) show_status ;;
  *) die "usage: session-switch [menu|lock|suspend|logout|shutdown|reboot|kde|windows|status]" ;;
esac
