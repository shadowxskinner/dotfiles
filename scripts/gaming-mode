#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/midnight-gaming-mode"
state_file="$state_dir/active"
containers=(hermes-gateway hermes-dashboard openwebui)

notify() {
  command -v notify-send >/dev/null && notify-send "Gaming Mode" "$1" || true
}

enable() {
  [[ ! -e "$state_file" ]] || { echo "Gaming Mode is already on"; return; }
  mkdir -p "$state_dir"
  chmod 700 "$state_dir"

  : >"$state_file.tmp"
  if command -v docker >/dev/null; then
    for container in "${containers[@]}"; do
      if [[ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null || true)" == true ]]; then
        printf 'container\t%s\n' "$container" >>"$state_file.tmp"
      fi
    done
  fi
  mv "$state_file.tmp" "$state_file"

  while IFS=$'\t' read -r kind value; do
    [[ "$kind" == container ]] && docker stop "$value" >/dev/null 2>&1 || true
  done <"$state_file"

  if command -v ollama >/dev/null; then
    ollama ps 2>/dev/null | awk 'NR > 1 {print $1}' | while IFS= read -r model; do
      [[ -n "$model" ]] && ollama stop "$model" >/dev/null 2>&1 || true
    done
  fi

  notify "On — local AI models and background services paused"
  echo "Gaming Mode is on"
}

disable() {
  [[ -e "$state_file" ]] || { echo "Gaming Mode is already off"; return; }
  while IFS=$'\t' read -r kind value; do
    [[ "$kind" == container ]] && docker start "$value" >/dev/null 2>&1 || true
  done <"$state_file"
  rm -f "$state_file"
  notify "Off — recorded background services restored"
  echo "Gaming Mode is off"
}

case "${1:-toggle}" in
  on) enable ;;
  off) disable ;;
  # if/else, not `&& disable || enable`: with that form a non-zero return from
  # disable falls through to enable, silently re-stopping the containers it
  # just restarted.
  toggle)
    if [[ -e "$state_file" ]]; then disable; else enable; fi
    ;;
  status) [[ -e "$state_file" ]] && echo on || echo off ;;
  *) echo "usage: gaming-mode [on|off|toggle|status]" >&2; exit 2 ;;
esac
