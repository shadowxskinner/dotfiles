#!/usr/bin/env bash
# Root helper for session-switch. Do not run directly; pkexec from session-switch.
# kde: one-shot SDDM autologin into Plasma, then restart the greeter.
# windows: BootNext = Windows Boot Manager for one reboot, then reboot.
# Neither action changes the default boot order or lasting SDDM autologin.
set -euo pipefail

ONCE_CONF=/etc/sddm.conf.d/zz-midnight-once.conf
STATE_CONF=/var/lib/sddm/state.conf
PLASMA_DESKTOP=/usr/share/wayland-sessions/plasma.desktop

usage() {
  echo "usage: midnight-session-helper [--dry-run] kde|windows" >&2
  exit 2
}

dry_run=0
if [[ "${1:-}" == --dry-run ]]; then
  dry_run=1
  shift
fi
action="${1:-}"
[[ "$action" == kde || "$action" == windows ]] || usage
[[ "$#" -eq 1 ]] || usage

if [[ "$(id -u)" -ne 0 ]]; then
  echo "midnight-session-helper must run as root" >&2
  exit 1
fi

target_user="${SUDO_USER:-}"
if [[ -z "$target_user" && -n "${PKEXEC_UID:-}" ]]; then
  target_user="$(getent passwd "$PKEXEC_UID" | cut -d: -f1 || true)"
fi
if [[ -z "$target_user" || "$target_user" == root ]]; then
  echo "cannot resolve the desktop user to switch" >&2
  exit 1
fi

windows_boot_id() {
  efibootmgr | awk -F'*' '
    /Windows Boot Manager/ {
      id = $1
      sub(/^Boot/, "", id)
      gsub(/[[:space:]]/, "", id)
      print id
      exit
    }
  '
}

if [[ "$action" == windows ]]; then
  boot_id="$(windows_boot_id)"
  if [[ ! "$boot_id" =~ ^[0-9A-Fa-f]{4}$ ]]; then
    echo "Windows Boot Manager was not found in efibootmgr" >&2
    exit 1
  fi
  if [[ "$dry_run" -eq 1 ]]; then
    echo "would set BootNext=$boot_id and reboot"
    exit 0
  fi
  efibootmgr --bootnext "$boot_id" >/dev/null
  systemctl reboot
  exit 0
fi

if [[ ! -f "$PLASMA_DESKTOP" ]]; then
  echo "Plasma Wayland session is not installed: $PLASMA_DESKTOP" >&2
  exit 1
fi

if [[ "$dry_run" -eq 1 ]]; then
  echo "would autologin $target_user into plasma and restart sddm"
  exit 0
fi

umask 022
cat >"$ONCE_CONF" <<EOF
[Autologin]
User=$target_user
Session=plasma
Relogin=false
EOF

mkdir -p "$(dirname "$STATE_CONF")"
cat >"$STATE_CONF" <<EOF
[Last]
User=$target_user
Session=$PLASMA_DESKTOP
EOF

systemd-run --collect --on-active=45s /bin/rm -f "$ONCE_CONF" >/dev/null
systemctl restart sddm
